// Compute the forward kinematics (position and orientation)
// input: the joints angles
// output: the 4x4 homogeneous transformation
void ForwardKinematics( double q1, double q2, double q3, double q4, double q5, double q6, double E[4][4] ){
  double fk[4][4];
  
  fk[0][0] = cos(q1+q2+q3+q4+q5+q6);
  fk[0][1] = sin(q1+q2+q3+q4+q5+q6)*-1.0;
  fk[0][2] = 0;
  fk[0][3] = cos(q1+q2+q3)*-3.92E-1-cos(q1+q2)*4.25E-1-cos(q5)*
	 (cos(q1+q2+q3)*sin(q4)*1.0E-1 +sin(q1+q2+q3)*cos(q4)*1.0E-1)-sin(q5)*(cos(q1+q2+q3)*cos(q4)*1.0E-1-sin(q1+q2+q3)*sin(q4)*1.0E-1)+cos(q1+q2+q3)*sin(q4)*1.0E-1+sin(q1+q2+q3)*cos(q4)*1.0E-1;
  fk[1][0] = sin(q1+q2+q3+q4+q5+q6);
  fk[1][1] = cos(q1+q2+q3+q4+q5+q6);
  fk[1][2] = 0;
  fk[1][3] = sin(q1+q2+q3)*-3.92E-1-sin(q1+q2)*4.25E-1+
    cos(q5)*(cos(q1+q2+q3)*cos(q4)*1.0E-1-sin(q1+q2+q3)*sin(q4)*1.0E-1)-sin(q5)*(cos(q1+q2+q3)*sin(q4)*1.0E-1+sin(q1+q2+q3)*cos(q4)*1.0E-1)-cos(q1+q2+q3)*cos(q4)*1.0E-1+sin(q1+q2+q3)*sin(q4)*1.0E-1;
  fk[2][0] = 0;
  fk[2][1] = 0;
  fk[2][2] = 1.0;
  fk[2][3] = 4.71E-1;
  fk[3][0] = 0;
  fk[3][1] = 0;
  fk[3][2] = 0;
  fk[3][3] = 1.0;


  // new stuff 9/23/2026

  // preset everything to zero
  for (int r = 0; r < 4; r++) {
	for (int c = 0; c < 4; c++) {
	  E[r][c] = 0.0;
	}
  }

  // fill in values from matlab
  E[0][0] = cos(q1+q2+q3+q4+q5+q6);
  E[0][1] = -sin(q1+q2+q3+q4+q5+q6);
  E[0][3] = sin(q1+q2+q3+q4+q5)*(-1.0/1.0E+1)-cos(q1+q2+q3)*(4.9E+1/1.25E+2)+sin(q1+q2+q3+q4)/1.0E+1-cos(q1+q2)*(1.7E+1/4.0E+1);
  E[1][0] = sin(q1+q2+q3+q4+q5+q6);
  E[1][1] = cos(q1+q2+q3+q4+q5+q6);
  E[1][3] = sin(q1+q2+q3)*(-4.9E+1/1.25E+2)-cos(q1+q2+q3+q4)/1.0E+1-sin(q1+q2)*(1.7E= cos(q5)*sin(q6)*1.0E-1;
  E[2][2] = 1.0;
  E[2][3] = 3.7E+1/1.25E+2;
  E[3][3] = 1.0;

}

// Compute the inverse of the forward kinematics (position and orientation)
// input: the joints angles
// output: the 4x4 homogeneous transformation
void ForwardKinematicsInverse( double q1, double q2, double q3, double q4, double q5, double q6, double E[4][4] ){

  double fk_inv[4][4];

  fk_inv[0][0] = cos(q1+q2+q3+q4+q5+q6);
  fk_inv[0][1] = sin(q1+q2+q3+q4+q5+q6);
