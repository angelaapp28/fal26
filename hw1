	dT[3][0] = 0;
	dT[3][1] = 0;
	dT[3][2] = 0;
	dT[3][3] = 0;
      }
    
}

// Compute and return the Jacobian of the robot given the current joint positions
// input: the joints angles
// output: the 6x6 Jacobian
void Jacobian( double q1, double q2, double q3, double q4, double q5, double q6, double J[6][6] ){


  double E_wg[4][4];
  ForwardKinematics(q1, q2, q3, q4, q5, q6, E_wg);

  
  for(int r=0; r<6; r++) {
    for(int c=0; c<6; c++) {
      J[r][c] = 0.0;
    }
  }

  double dE[4][4];
  for (int j = 0; j < 6; j++) {
    get_partials(q1, q2, q3, q4, q5, q6, j, dE);

    double columns[6];
    flatten(dE, columns);
  

    for (int r=0;r<6;r++) J[r][j] = columns[r];

  }


  // new code

  for (int r = 0; r < 6; r++) {
	for (int c = 0; c < 6; c++) {
		J[r][c] = 0.0;
	}
  }

    J[0][2] = sin(q1+q2)*(-1.7E+1/4.0E+1);
	J[0][3] = sin(q1+q2+q3)*(-4.9E+1/1.25E+2)-sin(q1+q2)*(1.7E+1/4.0E+1);
	J[0][4] = sin(q1+q2+q3)*(-4.9E+1/1.25E+2)-cos(q1+q2+q3+q4)/1.0E+1-sin(q1+q2)*(1.7E+1/4.0E+1);
	J[0][5] = sin(q1+q2+q3)*(-4.9E+1/1.25E+2)-cos(q1+q2+q3+q4)/1.0E+1-sin(q1+q2)*(1.7E+1/4.0E+1)+cos(q1+q2+q3+q4+q5)/1.0E+1;
	J[1][2] = cos(q1+q2)*(1.7E+1/4.0E+1);
	J[1][3] = cos(q1+q2+q3)*(4.9E+1/1.25E+2)+cos(q1+q2)*(1.7E+1/4.0E+1);
	J[1][4] = cos(q1+q2+q3)*(4.9E+1/1.25E+2)-sin(q1+q2+q3+q4)/1.0E+1+cos(q1+q2)*(1.7E+1/4.0E+1);
	J[1][5] = sin(q1+q2+q3+q4+q5)/1.0E+1+cos(q1+q2+q3)*(4.9E+1/1.25E+2)-sin(q1+q2+q3+q4)/1.0E+1+cos(q1+q2)*(1.7E+1/4.0E+1);
	J[5][0] = 1.0;
	J[5][1] = 1.0;
	J[5][2] = 1.0;
	J[5][3] = 1.0;
	J[5][4] = 1.0;
	J[5][5] = 1.0;




}
