  fk_inv[0][3] = sin(q6)*-1.0E-1+cos(q5)*sin(q6)*1.0E-1+cos(q6)*sin(q5)*1.0E-1+cos(q4)*cos(q5)*cos(q6)
	 *3.92E-1-cos(q4)*sin(q5)*sin(q6)*3.92E-1-cos(q5)*sin(q4)*sin(q6)*3.92E-1-cos(q6)*sin(q4)*sin(q5)
	 *3.92E-1+cos(q3)*cos(q4)*cos(q5)*cos(q6)*4.25E-1-cos(q3)*cos(q4)*sin(q5)*sin(q6)*4.25E-1-cos(q3)
	 *cos(q5)*sin(q4)*sin(q6)*4.25E-1-cos(q3)*cos(q6)*sin(q4)*sin(q5)*4.25E-1-cos(q4)*cos(q5)*sin(q3)
	 *sin(q6)*4.25E-1-cos(q4)*cos(q6)*sin(q3)*sin(q5)*4.25E-1-cos(q5)*cos(q6)*sin(q3)*sin(q4)*4.25E-1+sin(q3)*sin(q4)*sin(q5)*sin(q6)*4.25E-1;
  fk_inv[1][0] = sin(q1+q2+q3+q4+q5+q6)*-1.0;
  fk_inv[1][1] = cos(q1+q2+q3+q4+q5+q6);
  fk_inv[1][2] = 0;
  fk_inv[1][3] = cos(q6)*-1.0E-1+cos(q5)*cos(q6)*1.0E-1-sin(q5)*sin(q6)*1.0E-1+sin(q4)*sin(q5)*sin(q6)
	 *3.92E-1-cos(q4)*cos(q5)*sin(q6)*3.92E-1-cos(q4)*cos(q6)*sin(q5)*3.92E-1-cos(q5)*cos(q6)*sin(q4)
	 *3.92E-1-cos(q3)*cos(q4)*cos(q5)*sin(q6)*4.25E-1-cos(q3)*cos(q4)*cos(q6)*sin(q5)*4.25E-1-cos(q3)
	 *cos(q5)*cos(q6)*sin(q4)*4.25E-1-cos(q4)*cos(q5)*cos(q6)*sin(q3)*4.25E-1+cos(q3)*sin(q4)*sin(q5)
	 *sin(q6)*4.25E-1+cos(q4)*sin(q3)*sin(q5)*sin(q6)*4.25E-1+cos(q5)*sin(q3)*sin(q4)*sin(q6)*4.25E-1+cos(q6)*sin(q3)*sin(q4)*sin(q5)*4.25E-1;
  fk_inv[2][0] = 0;
  fk_inv[2][1] = 0;
  fk_inv[2][2] = 1.0;
  fk_inv[2][3] = -4.71E-1;
  fk_inv[3][0] = 0;
  fk_inv[3][1] = 0;
  fk_inv[3][2] = 0;
  fk_inv[3][3] = 1.0;



  // new code 9/23/2026

  for (int r = 0; r < 4; r++) {
	 for (int c = 0; c < 4; c++) {
	   E[r][c] = 0.0;
	 }
  }

    E[0][0] = cos(q1+q2+q3+q4+q5+q6);
    E[0][1] = sin(q1+q2+q3+q4+q5+q6);
	E[0][3] = cos(q4+q5+q6)*(4.9E+1/1.25E+2)+cos(q3+q4+q5+q6)*(1.7E+1/4.0E+1)+sin(q5+q6)/1.0E+1-sin(q6)/1.0E+1;
    E[1][0] = -sin(q1+q2+q3+q4+q5+q6);
    E[1][1] = cos(q1+q2+q3+q4+q5+q6);
    E[1][3] = sin(q4+q5+q6)*(-4.9E+1/1.25E+2)-sin(q3+q4+q5+q6)*(1.7E+1/4.0E+1)+cos(q5+q6)/1.0E+1-cos(q6)/1.0E+1;
    E[2][2] = 1.0;
    E[2][3] = -3.7E+1/1.25E+2;
    E[3][3] = 1.0;

}

// Compute the Adjoint transformation inverse matrix
// input E: the rotation/translation between the base and the hand frame
//          (as computed by the forward kinematics)
// output Ad: the 6x6 adjoint transformation inverse matrix
void AdjointTransformationInverse( double E[4][4], double Ad[6][6] ){

  double R_t[3][3], t[3];

  // getting the rotation(transpose) and translation aspect from E

  for (int i = 0; i < 3; i++) {
    t[i] = 0;
    for (int j = 0; j < 3; j++) {
      R_t[i][j] = E[j][i];
       t[i] -= Rt[i][j] * E[j][3];
    }
  }



  // formatting as t_hat (skew-symmetric)
  double t_hat[3][3] = { {0, -t[2], t[1]},
			 {t[2], 0, -t[0]},
			 {-t[1], t[0], 0} };

  

  for(int r=0; r<3; r++) {
    for(int c=0; c<3; c++) {
      Ad[r][c] = R_t[r][c]; //top left
      Ad[r][c+3] = 0; // top right
      Ad[r+3][c] = t_hat[r][c]; //bottom left
      Ad[r+3][c+3] = R_t[r][c];
    }
  }


  // new stuff 

  	for (int r = 0; r < 6; r++) {
		for (int c = 0; c < 6; c++) {
			Ad[r][c] = 0.0;
		}
	}


  	Ad[0][0] = cos(q1+q2+q3+q4+q5+q6);
    Ad[0][1] = -sin(q1+q2+q3+q4+q5+q6);
	Ad[0][3] = sin(q1+q2+q3+q4+q5+q6)*(-3.7E+1/1.25E+2);
	Ad[0][4] = cos(q1+q2+q3+q4+q5+q6)*(-3.7E+1/1.25E+2);
	Ad[0][5] = sin(q1+q2+q3)*(-4.9E+1/1.25E+2)-cos(q1+q2+q3+q4)/1.0E+1-sin(q1+q2)*(1.7E+1/4.0E+1)+cos(q1+q2+q3+q4+q5)/1.0E+1;
	Ad[1][0] = sin(q1+q2+q3+q4+q5+q6);
	Ad[1][1] = cos(q1+q2+q3+q4+q5+q6);
	Ad[1][3] = cos(q1+q2+q3+q4+q5+q6)*(3.7E+1/1.25E+2);
	Ad[1][4] = sin(q1+q2+q3+q4+q5+q6)*(-3.7E+1/1.25E+2);
	Ad[1][5] = sin(q1+q2+q3+q4+q5)/1.0E+1+cos(q1+q2+q3)*(4.9E+1/1.25E+2)-sin(q1+q2+q3+q4)/1.0E+1+cos(q1+q2)*(1.7E+1/4.0E+1);
	Ad[2][2] = 1.0;
	Ad[2][3] = sin(q4+q5+q6)*(-4.9E+1/1.25E+2)-sin(q3+q4+q5+q6)*(1.7E+1/4.0E+1)+cos(q5+q6)/1.0E+1-cos(q6)/1.0E+1;
	Ad[2][4] = cos(q4+q5+q6)*(-4.9E+1/1.25E+2)-cos(q3+q4+q5+q6)*(1.7E+1/4.0E+1)-sin(q5+q6)/1.0E+1+sin(q6)/1.0E+1;
	Ad[3][3] = cos(q1+q2+q3+q4+q5+q6);
	Ad[3][4] = -sin(q1+q2+q3+q4+q5+q6);
	Ad[4][3] = sin(q1+q2+q3+q4+q5+q6);
	Ad[4][4] = cos(q1+q2+q3+q4+q5+q6);
	Ad[5][5] = 1.0;
 
}


void flatten(const double d[4][4], double col_vec[6]) {
    // omega
    col_vec[0] = d[2][1]; 
    col_vec[1] = d[0][2];
    col_vec[2] = d[1][0]; 

    // linear part
    col_vec[3] = d[0][3];
    col_vec[4] = d[1][3];
    col_vec[5] = d[2][3];
}

